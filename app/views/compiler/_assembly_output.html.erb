<%
  is_error = assembly_output.to_s.start_with?("Erro")
  code_class = is_error ? "text-rose-400" : "text-zinc-300"
%>
<pre class="absolute top-0 left-0 h-full w-10 p-2 text-right text-zinc-600 bg-black/30 select-none overflow-hidden flex flex-col font-mono text-sm leading-6"
     data-compiler-target="outputLineNumbers"></pre>
<pre class="w-full h-full font-mono text-sm leading-6 p-2 pl-12 overflow-auto <%= code_class %>"
     data-action="scroll->compiler#syncScroll"
     data-compiler-output-code><%= assembly_output %></pre>
