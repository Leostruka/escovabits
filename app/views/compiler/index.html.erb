<%= form_with url: "/compile", method: :post, data: { controller: "compiler" }, class: "h-full flex flex-col gap-3 p-3 lg:p-4" do |form| %>
  <%= render "toolbar", form: form %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 lg:gap-4 flex-1 min-h-0">
    <%# Editor panel %>
    <div data-testid="editor-panel" class="frosted-panel rounded-xl border border-white/10 flex flex-col min-h-0 overflow-hidden">
      <div class="flex items-center justify-between px-3 py-2 border-b border-white/10">
        <span class="text-xs font-medium uppercase tracking-widest text-zinc-400">Código Fonte</span>
      </div>
      <div class="relative flex-1 min-h-0">
        <pre class="absolute top-0 left-0 h-full w-10 p-2 text-right text-zinc-600 bg-black/30 select-none overflow-hidden flex flex-col font-mono text-sm leading-6"
             data-compiler-target="sourceLineNumbers">1</pre>
        <%= form.text_area :source_code, value: @source_code,
              class: "w-full h-full bg-transparent font-mono text-sm leading-6 p-2 pl-12 resize-none outline-none focus-visible:ring-2 focus-visible:ring-teal-400/40 placeholder:text-zinc-600",
              placeholder: "Digite seu código aqui...",
              "aria-label": "Código fonte",
              data: { "compiler-target": "source", action: "input->compiler#startDebouncedCompile scroll->compiler#syncScroll" } %>
      </div>
    </div>

    <%# Output panel %>
    <div data-testid="output-panel" class="frosted-panel rounded-xl border border-white/10 flex flex-col min-h-0 overflow-hidden">
      <div class="flex items-center justify-between px-3 py-2 border-b border-white/10">
        <span class="text-xs font-medium uppercase tracking-widest text-zinc-400">
          Output (Assembly)
          <span class="ml-2 normal-case tracking-normal text-zinc-500" data-compiler-target="countdown"></span>
        </span>
        <button type="button"
                class="focus-visible:ring-2 focus-visible:ring-teal-400/70 outline-none rounded-lg px-2.5 py-1 text-xs font-medium bg-white/5 hover:bg-white/10 text-zinc-300 transition-colors"
                data-action="click->compiler#copyOutput">
          Copiar
        </button>
      </div>
      <div class="relative flex-1 min-h-0">
        <%= turbo_frame_tag "output_frame", class: "w-full h-full", data: { "compiler-target": "output" } do %>
          <pre class="absolute top-0 left-0 h-full w-10 p-2 text-right text-zinc-600 bg-black/30 select-none overflow-hidden flex flex-col font-mono text-sm leading-6"
               data-compiler-target="outputLineNumbers">1</pre>
          <pre class="w-full h-full font-mono text-sm leading-6 p-2 pl-12 overflow-auto text-zinc-400"
               data-action="scroll->compiler#syncScroll">
            O código Assembly aparecerá aqui...
          </pre>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
