# syntax=docker/dockerfile:1
# Test image: includes dev/test gems, g++, go, and Chromium for system tests.
ARG RUBY_VERSION=3.4.6
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libyaml-dev pkg-config \
      curl libjemalloc2 libvips sqlite3 g++ golang-go \
      chromium chromium-driver \
      && rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV RAILS_ENV="test" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="" \
    CI="true"

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

RUN SECRET_KEY_BASE_DUMMY=1 ./bin/rails assets:precompile

CMD ["bin/rails", "db:test:prepare", "test", "test:system"]
